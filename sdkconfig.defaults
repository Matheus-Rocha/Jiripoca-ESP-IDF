CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partition/16MB.csv"

# Jiripoca V5 settings
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_FATFS_LFN_NONE=y
CONFIG_FREERTOS_HZ=100
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

# Camera frame buffers and the pre-trigger ring live in PSRAM
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# OV2710 over MIPI-CSI, with the ISP auto exposure / white balance pipeline
CONFIG_CAMERA_OV2710=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
